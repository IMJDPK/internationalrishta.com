.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Backup / temp artifacts
*.bak
*.tmp
*.temp
.cache/

# Large local media (add assets locally; do not commit binaries)
/public/assets/**/*.mp4
/public/assets/**/*.mov
/public/assets/**/*.webm
/assets/**/*.mp4
/assets/**/*.mov
/assets/**/*.webm

# Optional: uncomment if you store large design exports locally
# /public/assets/
# /assets/

